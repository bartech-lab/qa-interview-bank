{
 "about": "Locator trainer (idea 50, docs/phase4-spec.md): the frozen pages in src/locators/pages/ and the tasks on each. A task is passed when the learner's locator matches the same elements as its answer.",
 "pages": [
  { "id": "signup", "title": "Sign up", "case": 36, "caseTitle": "Sign up", "doc": "cases/36-sign-up.md" },
  { "id": "billing-details", "title": "Billing details", "case": 138, "caseTitle": "Billing details", "doc": "cases/138-billing-details.md" },
  { "id": "expense-claims", "title": "Expense claims", "case": 119, "caseTitle": "Expense claims", "doc": "cases/119-expense-claims.md" },
  { "id": "settings", "title": "Settings", "case": 10, "caseTitle": "A toast and a page that is never idle", "doc": "cases/10-a-toast-and-a-page-that-is-never-idle.md" },
  { "id": "notes", "title": "Notes", "case": 19, "caseTitle": "Notes", "doc": "cases/19-notes.md" },
  { "id": "playlist", "title": "Playlist", "case": 22, "caseTitle": "Playlist", "doc": "cases/22-playlist.md" },
  { "id": "shop", "title": "Shop", "case": 11, "caseTitle": "Checkout total", "doc": "cases/11-checkout-total.md" },
  { "id": "orders", "title": "Orders", "case": 47, "caseTitle": "Orders", "doc": "cases/47-orders.md" },
  { "id": "product-tabs", "title": "Product details", "case": 92, "caseTitle": "Product details", "doc": "cases/92-product-details.md" },
  { "id": "gallery", "title": "Gallery", "case": 54, "caseTitle": "Gallery", "doc": "cases/54-gallery.md" }
 ],
 "tasks": [
  { "id": "signup-1", "page": "signup", "task": "Match the Email field.", "answer": "getByLabel('Email')" },
  { "id": "signup-2", "page": "signup", "task": "Match the button that creates the account.", "answer": "getByRole('button', { name: 'Create account' })" },
  { "id": "signup-3", "page": "signup", "task": "Match the three text fields of the Sign up form, and nothing else.", "answer": "getByRole('form', { name: 'Sign up' }).getByRole('textbox')" },
  { "id": "signup-4", "page": "signup", "task": "Match the Show password button.", "answer": "getByRole('button', { name: 'Show password' })" },
  { "id": "billing-details-1", "page": "billing-details", "task": "Match the radio button that is checked.", "answer": "getByRole('radio', { checked: true })" },
  { "id": "billing-details-2", "page": "billing-details", "task": "Match both radio buttons of the Buying as group.", "answer": "getByRole('group', { name: 'Buying as' }).getByRole('radio')" },
  { "id": "billing-details-3", "page": "billing-details", "task": "Match the checkbox by its label.", "answer": "getByLabel('Send invoices to a different email')" },
  { "id": "billing-details-4", "page": "billing-details", "task": "Match the Full name field.", "answer": "getByRole('textbox', { name: 'Full name' })" },
  { "id": "expense-claims-1", "page": "expense-claims", "task": "Match the Email field by its placeholder.", "answer": "getByPlaceholder('ewa@example.com')" },
  { "id": "expense-claims-2", "page": "expense-claims", "task": "Match the Sign in button, not the Sign in form.", "answer": "getByRole('button', { name: 'Sign in' })" },
  { "id": "expense-claims-3", "page": "expense-claims", "task": "Match the Password field inside the Sign in form.", "answer": "getByRole('form', { name: 'Sign in' }).getByLabel('Password')" },
  { "id": "settings-1", "page": "settings", "task": "Match the Theme drop-down.", "answer": "getByLabel('Theme')" },
  { "id": "settings-2", "page": "settings", "task": "Match the Dark option of the drop-down.", "answer": "getByRole('option', { name: 'Dark' })" },
  { "id": "settings-3", "page": "settings", "task": "Match the daily digest checkbox using only part of its label.", "answer": "getByLabel('daily digest')" },
  { "id": "settings-4", "page": "settings", "task": "Match the Save settings button.", "answer": "getByRole('button', { name: 'Save settings' })" },
  { "id": "notes-1", "page": "notes", "task": "Match the Archive button in the Actions toolbar.", "answer": "getByRole('toolbar', { name: 'Actions' }).getByRole('button', { name: 'Archive' })" },
  { "id": "notes-2", "page": "notes", "task": "Match the checkbox of the note Trip ideas.", "answer": "getByRole('checkbox', { name: 'Trip ideas' })" },
  { "id": "notes-3", "page": "notes", "task": "Match the list item that holds Book notes.", "answer": "getByRole('listitem').filter({ hasText: 'Book notes' })" },
  { "id": "notes-4", "page": "notes", "task": "Match the Archive heading, not the button.", "answer": "getByRole('heading', { name: 'Archive' })" },
  { "id": "notes-5", "page": "notes", "task": "Match the Star and the Delete buttons with one locator.", "answer": "getByRole('button', { name: 'Star' }).or(page.getByRole('button', { name: 'Delete' }))" },
  { "id": "playlist-1", "page": "playlist", "task": "Match the move button of Slow Train.", "answer": "getByRole('button', { name: 'Move Slow Train' })" },
  { "id": "playlist-2", "page": "playlist", "task": "Match all five songs.", "answer": "getByRole('list', { name: 'Playlist' }).getByRole('listitem')" },
  { "id": "playlist-3", "page": "playlist", "task": "Match the second song.", "answer": "getByRole('list', { name: 'Playlist' }).getByRole('listitem').nth(1)" },
  { "id": "shop-1", "page": "shop", "task": "Match the Add button of the Pen.", "answer": "getByRole('button', { name: 'Add Pen' })" },
  { "id": "shop-2", "page": "shop", "task": "Match the product list item of the Backpack.", "answer": "getByRole('listitem').filter({ hasText: 'Backpack' })" },
  { "id": "shop-3", "page": "shop", "task": "Match the order total by its test id.", "answer": "getByTestId('order-total')" },
  { "id": "shop-4", "page": "shop", "task": "Match every Add button in the Products list.", "answer": "getByRole('list', { name: 'Products' }).getByRole('button', { name: /^Add / })" },
  { "id": "shop-5", "page": "shop", "task": "Match the Place order button, which is disabled.", "answer": "getByRole('button', { name: 'Place order', disabled: true })" },
  { "id": "orders-1", "page": "orders", "task": "Match the table row of order 1003.", "answer": "getByRole('row').filter({ hasText: '1003' })" },
  { "id": "orders-2", "page": "orders", "task": "Match every row with an order from Ann.", "answer": "getByRole('row').filter({ hasText: 'Ann' })" },
  { "id": "orders-3", "page": "orders", "task": "Match the sort button in the Total column header.", "answer": "getByRole('columnheader', { name: 'Total' }).getByRole('button')" },
  { "id": "orders-4", "page": "orders", "task": "Match the last row of the table.", "answer": "getByRole('row').last()" },
  { "id": "orders-5", "page": "orders", "task": "Match the Previous button, which is disabled.", "answer": "getByRole('button', { name: 'Previous', disabled: true })" },
  { "id": "product-tabs-1", "page": "product-tabs", "task": "Match the Reviews tab.", "answer": "getByRole('tab', { name: 'Reviews' })" },
  { "id": "product-tabs-2", "page": "product-tabs", "task": "Match the tab panel that is showing.", "answer": "getByRole('tabpanel')" },
  { "id": "product-tabs-3", "page": "product-tabs", "task": "Match all four tab panels, hidden ones too.", "answer": "getByRole('tabpanel', { includeHidden: true })" },
  { "id": "product-tabs-4", "page": "product-tabs", "task": "Match every tab of the Product details tab list.", "answer": "getByRole('tablist', { name: 'Product details' }).getByRole('tab')" },
  { "id": "gallery-1", "page": "gallery", "task": "Match photo 3 by its alt text.", "answer": "getByAltText('Photo 3 of 24 from the trip')" },
  { "id": "gallery-2", "page": "gallery", "task": "Match every photo of the trip, and no other image.", "answer": "getByAltText(/^Photo \\d+ of 24/)" },
  { "id": "gallery-3", "page": "gallery", "task": "Match only the first photo of the trip.", "answer": "getByAltText(/from the trip/).first()" }
 ]
}
